{
	"name": "ngx-editra",
	"version": "1.0.1",
	"peerDependencies": {
		"@angular/common": ">=17.0.0 <23.0.0",
		"@angular/core": ">=17.0.0 <23.0.0",
		"@angular/forms": ">=17.0.0 <23.0.0",
		"@angular/platform-browser": ">=17.0.0 <23.0.0"
	},
	"dependencies": {
		"tslib": "^2.3.0",
		"prosemirror-model": "1.25.12",
		"prosemirror-state": "1.4.4",
		"prosemirror-view": "1.42.6",
		"prosemirror-commands": "1.7.2",
		"prosemirror-schema-list": "1.5.1",
		"prosemirror-history": "1.5.1",
		"prosemirror-keymap": "1.2.3",
		"prosemirror-tables": "1.8.5",
		"prosemirror-markdown": "1.13.8",
		"parse5": "8.0.1"
	},
	"sideEffects": false,
	"description": "Modular ProseMirror rich-text editor for Angular",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Khatri-Sanjay/ngx-editra.git",
		"directory": "packages/ngx-editra"
	},
	"homepage": "https://ngx-editra-docs.vercel.app",
	"bugs": {
		"url": "https://github.com/Khatri-Sanjay/ngx-editra/issues"
	},
	"license": "MIT",
	"keywords": [
		"angular",
		"editor",
		"prosemirror",
		"rich-text"
	],
	"exports": {
		"./styles/content.scss": {
			"sass": "./styles/content.scss",
			"default": "./styles/content.scss"
		},
		"./styles/editor.scss": {
			"sass": "./styles/editor.scss",
			"default": "./styles/editor.scss"
		}
	},
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	}
}
