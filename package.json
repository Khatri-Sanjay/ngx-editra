{
	"name": "ngx-editra-workspace",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"validate": "node scripts/validate.mjs",
		"release": "node scripts/release.mjs",
		"release:check": "node scripts/release.mjs --check",
		"release:publish": "node scripts/release.mjs --publish",
		"verify:evidence": "node scripts/verify-release.mjs",
		"test:maintenance": "node --test scripts/release-evidence.test.mjs scripts/release.test.mjs scripts/library-docs.test.mjs scripts/app-workspace.test.mjs",
		"start": "node scripts/run-app.mjs serve playground",
		"start:all": "node scripts/start-apps.mjs",
		"build:site": "node scripts/build-site.mjs",
		"build": "node scripts/build-library.mjs",
		"watch": "ng build ngx-editra --watch --configuration development",
		"test": "ng test ngx-editra",
		"lint": "eslint packages apps/playground apps/documentation --max-warnings=0",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "ngc -p packages/ngx-editra/tsconfig.lib.json --noEmit && ngc -p packages/ngx-editra/tsconfig.spec.json --noEmit",
		"test:ci": "ng test ngx-editra --watch=false --browsers=ChromeHeadless",
		"test:ssr": "node scripts/verify-rendering.mjs",
		"build:playground": "node scripts/run-app.mjs build playground",
		"test:e2e": "playwright test",
		"pack": "node scripts/pack.mjs",
		"serve:ssr:playground": "node scripts/run-app.mjs serve-built playground",
		"test:compatibility": "node scripts/run-compatibility.mjs",
		"test:performance": "node scripts/performance.mjs",
		"serve:ssr:documentation": "node scripts/run-app.mjs serve-built documentation",
		"docs:generate": "node scripts/generate-documentation.mjs",
		"docs:check": "node scripts/generate-documentation.mjs --check",
		"package:sync": "node scripts/sync-npm-package.mjs",
		"start:docs": "node scripts/generate-documentation.mjs && node scripts/run-app.mjs serve documentation",
		"build:docs": "node scripts/generate-documentation.mjs && node scripts/run-app.mjs build documentation",
		"serve:ssr:docs": "node scripts/run-app.mjs serve-built documentation",
		"test:docs": "playwright test --config playwright.docs.config.ts",
		"prestart:docs": "npm run build",
		"prebuild:docs": "npm run build",
		"prestart": "npm run build",
		"prebuild:playground": "npm run build",
		"test:architecture": "node scripts/eslint-boundaries.test.cjs",
		"audit:dependencies": "node scripts/audit-dependencies.mjs",
		"repo:check": "node scripts/check-repository.mjs",
		"acceptance:check": "node scripts/check-acceptance.mjs",
		"dev:clean": "ng cache clean && node scripts/run-app.mjs clean-cache playground && node scripts/run-app.mjs clean-cache documentation"
	},
	"private": true,
	"devDependencies": {
		"@angular-devkit/build-angular": "^17.3.17",
		"@angular-eslint/eslint-plugin": "17.5.3",
		"@angular-eslint/eslint-plugin-template": "17.5.3",
		"@angular-eslint/template-parser": "17.5.3",
		"@angular/cli": "^17.3.17",
		"@angular/compiler-cli": "^17.3.0",
		"@playwright/test": "1.64.0",
		"@types/jasmine": "~5.1.0",
		"@types/node": "^18.18.0",
		"@typescript-eslint/eslint-plugin": "7.18.0",
		"@typescript-eslint/parser": "7.18.0",
		"axe-core": "4.14.0",
		"eslint": "8.57.1",
		"eslint-config-prettier": "9.1.0",
		"jasmine-core": "~5.1.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"ng-packagr": "^17.3.0",
		"prettier": "3.3.3",
		"typescript": "~5.4.2",
		"markdown-it": "15.0.2",
		"@angular/common": "^17.3.0",
		"@angular/compiler": "^17.3.0",
		"@angular/core": "^17.3.0",
		"@angular/forms": "^17.3.0",
		"@angular/platform-browser": "^17.3.0",
		"@angular/platform-browser-dynamic": "^17.3.0",
		"@angular/platform-server": "^17.3.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"zone.js": "~0.14.3"
	},
	"engines": {
		"node": ">=20.9.0 <21",
		"npm": ">=10 <11"
	},
	"packageManager": "npm@10.8.2",
	"workspaces": [
		"packages/ngx-editra"
	]
}
